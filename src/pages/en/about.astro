---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutSection from '@/components/AboutSection.astro';

const locale = 'en' as const;
const title = 'About Note — Software Engineer | Bangkok';
const description =
  "I'm a software engineer at ODDS, working across UX/UI, frontend and backend in a Scrum team. Computer Engineering (Honours), Suranaree University of Technology.";
---

<BaseLayout title={title} description={description}>
  <div class="pt-24 lg:pt-32">
    <AboutSection locale={locale} />
  </div>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import AboutSection from '@/components/AboutSection.astro';

const locale = 'en' as const;
const title = 'Note — Software Engineer | Bangkok';
const description =
  "Hi, I'm Note, a software engineer who takes products from user flow to backend. Building web products that balance user needs, business goals and maintainable code.";
---

<BaseLayout title={title} description={description}>
  <Hero locale={locale} />
  <WorkGrid locale={locale} />
  <AboutSection locale={locale} />
</BaseLayout>

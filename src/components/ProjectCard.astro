---
import type { CollectionEntry } from 'astro:content';
import { type Locale, createTranslator, getLocalizedPath } from '@/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  slug: string;
  locale: Locale;
  size: 'large' | 'small';
}

const { project, slug, locale, size } = Astro.props;
const t = createTranslator(locale);
const { title, summary, role, stack, badges } = project.data;

const href = getLocalizedPath(`/work/${slug}`, locale);
const isLarge = size === 'large';

const badgeLabels: Record<string, string> = {
  new: t('work.badges.new'),
  production: t('work.badges.production'),
};
---

<article class="group h-full bg-surface hover:bg-line/30 transition-colors duration-DEFAULT">
  <a
    href={href}
    class="block h-full p-6 lg:p-8"
    aria-label={`${title} - ${t('work.cardCta')}`}
  >
    <div class={`flex flex-col h-full ${isLarge ? 'min-h-[280px] lg:min-h-[320px]' : 'min-h-[200px]'}`}>
      <header class="mb-4">
        {badges && badges.length > 0 && (
          <div class="mb-3">
            <span 
              class="inline-block px-2 py-1 text-xs font-medium text-on-accent"
              style="background-color: var(--color-accent);"
            >
              {badges.map((badge: string) => badgeLabels[badge] || badge).join(' · ')}
            </span>
          </div>
        )}
        <h3 class={`font-display mb-2 ${isLarge ? 'text-h2' : 'text-h3'}`}>
          {title}
        </h3>
        <p class="text-muted text-sm lg:text-base line-clamp-2">
          {summary}
        </p>
      </header>

      <div class="mt-auto space-y-4">
        <div class="card-details opacity-100 lg:opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-DEFAULT">
          <p class="text-sm text-muted mb-3 line-clamp-2">
            {role}
          </p>

          <div class="flex flex-wrap gap-2">
            {
              stack.slice(0, isLarge ? 6 : 4).map((tech: string) => (
                <span 
                  class="px-3 py-1 text-xs text-on-accent"
                  style="background-color: var(--color-accent);"
                >
                  {tech}
                </span>
              ))
            }
            {stack.length > (isLarge ? 6 : 4) && (
              <span 
                class="px-3 py-1 text-xs text-on-accent"
                style="background-color: var(--color-accent);"
              >
                +{stack.length - (isLarge ? 6 : 4)}
              </span>
            )}
          </div>
        </div>

        <div class="flex items-center gap-2 text-accent-text font-medium text-sm group-hover:gap-3 group-focus-within:gap-3 transition-all duration-fast">
          <span>{t('work.cardCta')}</span>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  @media (hover: none) {
    .card-details {
      opacity: 1 !important;
    }
  }
</style>

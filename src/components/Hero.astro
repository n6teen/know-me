---
import { type Locale, createTranslator } from '@/i18n';
import Marquee from './Marquee.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createTranslator(locale);
---

<section
  class="hero-height safe-top safe-bottom relative flex flex-col justify-center"
  aria-labelledby="hero-heading"
>
  <div class="container flex flex-1 items-center">
    <div class="grid-layout w-full items-center">
      <div class="col-span-12 space-y-6 lg:col-span-7 lg:space-y-8">
        <h1 id="hero-heading" class="reveal font-display text-hero text-text">
          {t('hero.headline')}
        </h1>

        <p
          class="reveal max-w-2xl text-base text-muted lg:text-h3"
          style="transition-delay: 100ms;"
        >
          {t('hero.subhead')}
        </p>

        <div class="reveal flex flex-wrap gap-4" style="transition-delay: 200ms;">
          <a href="#work" class="btn btn-primary">
            {t('hero.ctaPrimary')}
          </a>
          <a href="#contact" class="btn btn-secondary">
            {t('hero.ctaSecondary')}
          </a>
        </div>
      </div>

      <div class="reveal col-span-12 mt-8 lg:col-span-5 lg:mt-0" style="transition-delay: 300ms;">
        <div
          id="hero-3d-slot"
          class="relative mx-auto aspect-square max-w-md lg:max-w-none"
          aria-label={t('hero.alt3dFallback')}
        >
          {/* Glow effect behind the 3D slot */}
          <div
            class="absolute inset-0 -z-10 opacity-30 blur-3xl"
            style="background: radial-gradient(circle at center, var(--color-glow) 0%, transparent 70%);"
            aria-hidden="true"
          >
          </div>

          <div
            class="hero-placeholder flex h-full w-full items-center justify-center border border-line bg-surface"
            style="border-radius: var(--radius-card);"
          >
            <div class="p-6 text-center">
              <div
                class="mx-auto mb-4 flex h-24 w-24 items-center justify-center"
                style="background-color: color-mix(in srgb, var(--color-glow) 15%, transparent); border-radius: var(--radius-input);"
              >
                <svg
                  width="48"
                  height="48"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  class="text-glow"
                  aria-hidden="true"
                >
                  <path
                    d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                  ></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              </div>
              <p class="hidden text-sm text-muted md:block" data-hint="pointer">
                {t('hero.hint3dPointer')}
              </p>
              <p class="text-sm text-muted md:hidden" data-hint="touch">
                {t('hero.hint3dTouch')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Marquee locale={locale} />

  <div class="absolute bottom-24 left-1/2 -translate-x-1/2 animate-bounce">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="text-muted"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .animate-bounce {
      animation: none;
    }
  }
</style>

# Cloudflare Turnstile - spam protection for contact form
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Upstash Redis - rate limiting for contact form
# Create a database at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Resend - email delivery for contact form
# Get API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Contact form email configuration
# Recipient email address(es), comma-separated for multiple
CONTACT_TO_EMAIL=you@example.com
# Sender email address (defaults to onboarding@resend.dev if not set)
# Use a verified domain for production: https://resend.com/docs/dashboard/domains/introduction
CONTACT_FROM_EMAIL=onboarding@resend.dev
